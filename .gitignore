# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 本地 https 用的私钥与服务器证书（只在本机，不进仓库；信任根 public/stellasei-ca.crt 要进）
/certificates/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 编辑器自带目录（会被占用，且不属于项目源码）
/.dumate/

# 手改前留的备份，不进仓库（真历史在 git 里）
*.bak

# 头脑风暴可视化伴侣的临时小样（本机对话用，不进仓库）
/.superpowers/

# 设计阶段样张（public/ 会被打进公开部署，这些只在本机预览：不进仓库、不上公开站）
/public/*.html

# Local Netlify folder
.netlify
/dist/
.vinext/
.cloudflare/

# 仓库只留代码（2026-10-29 恩熙要求）：项目记忆、工作日志、参考资料、调试快照都只留在本机，
# 仍可在 d:\Stellasei-New 里读到，只是不再进版本管理、GitHub 上也看不见。
/docs/
/AGENTS.md
/CLAUDE.md
/debug-*.md
/设计风格参考.md
/.dbg/
/.trae/
